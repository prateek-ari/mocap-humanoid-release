[Unit]
Description=Mocap G1 operator status console (no robot control)
Documentation=file:///usr/local/share/doc/mocap-g1/operator-console.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mocap-g1
Group=mocap-g1
UMask=0077
Environment=PYTHONUNBUFFERED=1
# Capability verification key, read by the console from
# $CREDENTIALS_DIRECTORY/mocap-g1-capability-key (never an environment
# variable). systemd copies /etc/credstore/mocap-g1-capability-key (root-owned,
# 0600) into a private, read-only credential directory for this unit only.
# The source file must exist; leave it empty while hardware stays locked.
LoadCredential=mocap-g1-capability-key
ExecStart=/opt/mocap-g1/current/bin/mocap-g1-console --host 127.0.0.1 --port 8766 --data-root /var/lib/mocap-g1-console
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s

# The console is an unprivileged status/session UI. It gets no hardware device,
# realtime, kernel, or privilege-escalation access. Robot control is a separate
# supervised service and must never be added to this unit.
StateDirectory=mocap-g1-console
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Loopback-only network policy matching the 127.0.0.1 bind. A commissioned LAN
# binding needs a reviewed drop-in that adds only the paired source address,
# and the console refuses it unless --identity-header and --trusted-proxy name
# an identity-aware proxy in front of it.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
PrivateUsers=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
